<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Huskagent Windows 4 Installer</title>
<hta:application id="huskagent" applicationname="Huskagent Windows 4 Installer" border="thin" caption="yes" maximizebutton="yes" minimizebutton="yes" showintaskbar="yes" singleinstance="yes" sysmenu="yes" />
<style>
body{font-family:Segoe UI,Arial;background:#081426;color:#eaf2ff;margin:0}header{padding:22px 28px;background:#10284a;border-bottom:1px solid #2f5f95}h1{font-size:26px;margin:0 0 5px}.sub{color:#9fc5ee}.wrap{padding:20px 28px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.card,.disk{background:#10213a;border:1px solid #234c79;border-radius:8px;padding:15px}.label{color:#9fc5ee;font-size:12px;text-transform:uppercase}.value{font-size:20px;margin-top:6px}.disk{margin-top:12px}.disk h3{margin:0 0 8px}.pill{display:inline-block;padding:4px 8px;border-radius:12px;background:#174c7d;margin-right:6px;font-size:12px}.actions{margin-top:22px;display:flex;gap:10px}button{background:#1769aa;color:white;border:0;border-radius:5px;padding:10px 16px;font-size:14px;cursor:pointer}button.danger{background:#9e2b37}button.secondary{background:#31506e}#status{margin-top:14px;color:#9fc5ee;min-height:20px}table{width:100%;border-collapse:collapse;margin-top:10px}td,th{text-align:left;border-bottom:1px solid #285078;padding:6px;font-size:13px}
</style>
<script>
var shell=new ActiveXObject('WScript.Shell');
function readFile(path){var fso=new ActiveXObject('Scripting.FileSystemObject');if(!fso.FileExists(path))return null;var file=fso.OpenTextFile(path,1,false,-1);var text=file.ReadAll();file.Close();return text;}
function run(command){shell.Run('powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "'+command.replace(/"/g,'\\"')+'"',0,true);}
function refresh(){document.getElementById('status').innerText='Collecting live hardware inventory...';run("& X:\\Get-HardwareInventory.ps1 -OutputPath X:\\Huskagent-Hardware.json");render();document.getElementById('status').innerText='Inventory refreshed from WinPE.';}
function prepare(){var value=prompt('Enter the target disk number. This erases its partitions.','');if(value===null||!/^[0-9]+$/.test(value))return;var confirmation=prompt('Type PREPARE DISK '+value+' to continue.','');if(confirmation!=='PREPARE DISK '+value){alert('Confirmation did not match. No changes made.');return;}run("& X:\\Start-Windows4Installer.ps1 -Action Prepare -DiskNumber "+value);refresh();}
function esc(value){return String(value==null?'':value).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function render(){var raw=readFile('X:\\Huskagent-Hardware.json');if(!raw){document.getElementById('status').innerText='No inventory found. Click Refresh.';return;}var d=JSON.parse(raw);document.getElementById('summary').innerHTML='<div class="card"><div class="label">Firmware</div><div class="value">'+esc(d.Firmware)+'</div></div><div class="card"><div class="label">Architecture</div><div class="value">'+esc(d.Architecture)+'</div></div><div class="card"><div class="label">Memory</div><div class="value">'+esc(d.Computer.MemoryGB)+' GB</div></div><div class="card"><div class="label">USB devices</div><div class="value">'+d.UsbDevices.length+'</div></div>';
var html='';d.Disks.forEach(function(x){html+='<div class="disk"><h3>Disk '+x.Number+' — '+esc(x.FriendlyName)+'</h3><span class="pill">'+esc(x.BusType)+'</span><span class="pill">'+esc(x.PartitionStyle)+'</span><span class="pill">'+esc(x.SizeGB)+' GB</span><table><tr><th>Partition</th><th>Letter</th><th>Type</th><th>Size</th><th>Boot/System</th></tr>';x.Partitions.forEach(function(p){html+='<tr><td>'+p.Number+'</td><td>'+esc(p.DriveLetter)+'</td><td>'+esc(p.Type)+'</td><td>'+p.SizeGB+' GB</td><td>'+(p.IsBoot?'Boot ':'')+(p.IsSystem?'System':'')+'</td></tr>';});html+='</table></div>';});document.getElementById('disks').innerHTML=html||'<div class="disk">No disks reported by WinPE.</div>';document.getElementById('usb').innerHTML=d.UsbDevices.map(function(x){return '<div class="card"><b>'+esc(x.Model)+'</b><br>'+esc(x.SizeGB)+' GB · '+esc(x.Interface)+'</div>';}).join('')||'<div class="card">No USB storage devices detected.</div>';document.getElementById('machine').innerText=esc(d.Computer.Manufacturer)+' '+esc(d.Computer.Model)+' · '+esc(d.Computer.Processor);}
function boot(){try{render();}catch(e){document.getElementById('status').innerText='Unable to render inventory: '+e.message;}}
</script>
</head>
<body onload="boot()"><header><h1>HUSKAGENT WINDOWS 4</h1><div class="sub">Phase 2 installer · live WinPE hardware detection</div><div id="machine" class="sub"></div></header><div class="wrap"><div id="summary" class="grid"></div><h2>Storage and partitions</h2><div id="disks"></div><h2>USB devices</h2><div id="usb" class="grid"></div><div class="actions"><button onclick="refresh()">Refresh inventory</button><button class="danger" onclick="prepare()">Prepare target disk</button><button class="secondary" onclick="window.close()">Exit</button></div><div id="status"></div></div></body></html>
