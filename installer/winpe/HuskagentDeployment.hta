<!doctype html><html><head><meta charset="utf-8"><title>Huskagent Windows 4 Deployment</title><hta:application id="huskagent" applicationname="Huskagent Windows 4 Deployment" border="thin" caption="yes" maximizebutton="yes" minimizebutton="yes" showintaskbar="yes" singleinstance="yes" sysmenu="yes"/><style>body{font:14px Segoe UI;background:#081426;color:#eaf2ff;margin:0}header{padding:20px 28px;background:#10284a}h1{margin:0;font-size:25px}.sub{color:#9fc5ee}.wrap{padding:20px 28px}select,input,button{padding:9px;border-radius:5px;border:1px solid #315b85;background:#122a46;color:#fff}button{background:#1769aa;cursor:pointer}.danger{background:#9e2b37}.field{display:grid;grid-template-columns:180px 1fr;gap:10px;align-items:center;margin:10px 0}.card{background:#10213a;border:1px solid #234c79;border-radius:8px;padding:15px;margin:12px 0}.status{color:#9fc5ee;min-height:24px;white-space:pre-wrap}table{width:100%;border-collapse:collapse}td,th{text-align:left;padding:7px;border-bottom:1px solid #285078}</style><script>var shell=new ActiveXObject('WScript.Shell');function read(path){var f=new ActiveXObject('Scripting.FileSystemObject');if(!f.FileExists(path))return '';var x=f.OpenTextFile(path,1,false,-1),v=x.ReadAll();x.Close();return v}function run(c){return shell.Run('powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "'+c.replace(/"/g,'\\"')+'"',0,true)}function esc(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}function load(){document.getElementById('status').innerText='Reading live image and disk catalogs...';run('& X:\\DeploymentEngine.ps1 -ListImages -OutputPath X:\\Huskagent-Images.json');run('& X:\\DeploymentEngine.ps1 -ListTargets -OutputPath X:\\Huskagent-Targets.json');var i=JSON.parse(read('X:\\Huskagent-Images.json')||'[]'),d=JSON.parse(read('X:\\Huskagent-Targets.json')||'[]'),a=document.getElementById('image'),t=document.getElementById('target');a.innerHTML='';i.forEach(function(x){var o=document.createElement('option');o.value=x.Path+'|'+x.Index;o.text=x.Name+' · '+x.Architecture+' · index '+x.Index+' · '+x.Path;a.appendChild(o)});t.innerHTML='';d.forEach(function(x){var o=document.createElement('option');o.value=x.Number;o.text='Disk '+x.Number+' · '+x.Name+' · '+x.SizeGB+' GB · '+x.Style;t.appendChild(o)});document.getElementById('status').innerText=i.length?'Select an image and target disk.':'No .wim/.esd images found. Add deployment media to X:\\Huskagent\\Images or another source.'}function deploy(){var s=document.getElementById('image').value.split('|'),disk=document.getElementById('target').value;if(!s[0]||disk===''){alert('Select an image and target disk.');return}var answer=prompt('This will erase disk '+disk+'. Type DEPLOY DISK '+disk+' to continue.','');if(answer!=='DEPLOY DISK '+disk){document.getElementById('status').innerText='Confirmation did not match; no changes made.';return}document.getElementById('status').innerText='Deploying. Do not power off the computer...';run('& X:\\DeploymentEngine.ps1 -Deploy -ImagePath \''+s[0].replace(/'/g,"''")+'\' -ImageIndex '+s[1]+' -DiskNumber '+disk+' -Confirmed');document.getElementById('status').innerText=read('X:\\Huskagent-Deployment.json')||'Deployment finished.'}function boot(){try{load()}catch(e){document.getElementById('status').innerText=e.message}}</script></head><body onload="boot()"><header><h1>HUSKAGENT WINDOWS 4</h1><div class="sub">Phase 3 deployment engine · image-based installation</div></header><div class="wrap"><div class="card"><div class="field"><label>Deployment image</label><select id="image"></select></div><div class="field"><label>Target disk</label><select id="target"></select></div><div class="field"><label>Firmware</label><select id="firmware"><option>Auto</option><option>UEFI</option><option>BIOS</option></select></div><div class="field"><label>Architecture</label><select id="architecture"><option>x64</option><option>x86</option></select></div></div><div class="card"><h3>Deployment plan</h3><table><tr><td>Image application</td><td>DISM / Expand-WindowsImage</td></tr><tr><td>Partitions</td><td>GPT/EFI/MSR for UEFI or MBR/System Reserved for BIOS</td></tr><tr><td>Boot configuration</td><td>BCDBoot</td></tr><tr><td>Verification</td><td>OS, marker, and boot files</td></tr></table></div><button class="danger" onclick="deploy()">Deploy to target disk</button> <button onclick="load()">Refresh</button> <button onclick="window.close()">Exit</button><div id="status" class="status"></div></div></body></html>
